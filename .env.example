# Runtime
NODE_ENV=development
PORT=5020
WEB_URL=http://localhost:3000

# Postgres. The POSTGRES_* values configure the local container; the app reads
# only DATABASE_URL, matching production and the JobOps convention.
POSTGRES_USER=mailops
POSTGRES_PASSWORD=mailops
POSTGRES_DB=mailops
POSTGRES_PORT=5436
DATABASE_URL="postgresql://mailops:mailops@localhost:5436/mailops?schema=public"

# Authentication and initial seed. Generate a production secret with:
#   openssl rand -base64 48
AUTH_SECRET=replace-this-with-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production

# AI
OPENAI_API_KEY=

# Polling
IMAP_POLL_SECONDS=60

# JSON array seeded only by the initial migration. Keep this on one line.
MAIL_ACCOUNTS=[]

# Browser API origin. Empty means same-origin and is the production setting.
NEXT_PUBLIC_API_URL=http://localhost:5020
